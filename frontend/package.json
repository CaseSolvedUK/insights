{
	"name": "insights-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "yarn copy-all && vite",
		"serve": "yarn copy-all && vite preview",
		"build": "yarn copy-all && NODE_OPTIONS='--max-old-space-size=2048' vite build -l warn --base=/assets/insights/frontend/ && yarn copy-html-entry",
		"build-debug": "NODE_OPTIONS='--max-old-space-size=2048' vite build --debug --profile -l warn --base=/assets/insights/frontend/",
		"copy-all": "yarn copy-echarts && yarn copy-frappeui",
		"copy-echarts": "cp ../node_modules/echarts/dist/echarts.min.js ./public/",
		"copy-frappeui": "mkdir -p ./public/frappe-ui && cp ../node_modules/frappe-ui/dist/* ./public/frappe-ui",
		"copy-html-entry": "cp ../insights/public/frontend/index.html ../insights/www/insights.html"
	},
	"dependencies": {
		"@codemirror/lang-javascript": "^6.0.2",
		"@codemirror/lang-python": "^6.1.3",
		"@codemirror/lang-sql": "^6.4.0",
		"@formkit/auto-animate": "^0.8.1",
		"@headlessui/vue": "^1.7.17",
		"@tanstack/vue-table": "^8.10.7",
		"@vue-flow/core": "^1.23.0",
		"buffer": "^6.0.3",
		"codemirror": "^6.0.1",
		"dayjs": "^1.11.6",
		"dom-to-image": "^2.6.0",
		"echarts": "^5.5.0",
		"es-toolkit": "^1.34.1",
		"feather-icons": "^4.28.0",
		"frappe-ui": "https://github.com/CaseSolvedUK/frappe-ui.git#buildtolib",
		"grid-layout-plus": "^1.0.2",
		"highlight.js": "^11.11.1",
		"lucide-static": "^0.535.0",
		"lucide-vue-next": "^0.484.0",
		"pinia": "^2.0.30",
		"reka-ui": "^2.5.0",
		"thememirror": "^2.0.1",
		"vue": "^3.5.13",
		"vue-codemirror": "^6.0.1",
		"vue-router": "^4.2.2",
		"vue-sonner": "^1.0.3",
		"vuedraggable": "^4.1.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.32.1",
		"@tailwindcss/container-queries": "^0.1.1",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"@typescript-eslint/parser": "^8.46.2",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vitejs/plugin-vue-jsx": "^4.2.0",
		"autoprefixer": "^10.4.7",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.5.1",
		"postcss": "^8.4.14",
		"prettier": "^2.6.2",
		"prettier-plugin-tailwindcss": "^0.1.11",
		"rollup-plugin-visualizer": "^6.0.5",
		"sass": "^1.77.6",
		"tailwindcss": "3.4.17",
		"typescript": "^5.5.2",
		"vite": "^5.4.8",
		"vue-eslint-parser": "^10.2.0",
		"vue-tsc": "^2.0.21"
	}
}
